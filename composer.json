{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "barryvdh/laravel-snappy": "^1.0.5",
        "botman/botman": "^2.8",
        "botman/driver-web": "^1.5",
        "breeswish/php-marked": "^0.3.3",
        "google-gemini-php/laravel": "^2.0",
        "guzzlehttp/guzzle": "^7.2",
        "h4cc/wkhtmltopdf-amd64": "^0.12.4",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "jantinnerezo/livewire-alert": "^4.0",
        "jeroennoten/laravel-adminlte": "^3.8",
        "ladumor/laravel-pwa": "^0.0.3",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.0",
        "livewire/livewire": "^3.8",
        "lucianotonet/groq-php": "^0.0.8",
        "nullpunkt/lz-string-php": "^1.3",
        "rappasoft/laravel-livewire-tables": "^3.0",
        "silviolleite/laravelpwa": "^2.0",
        "spatie/pdf-to-image": "^3.1",
        "yajra/laravel-datatables": "^12.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.65",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
